{
  "schema_version": 2,
  "name": "read",
  "description": "Read a file or directory's contents with content-hashed LINE#HASH anchors, or resolve internal (`artifact://`, `skill://`, `local://`) and registered custom URI handles.",
  "permission": "read_only",
  "protected": true,
  "overrides": "hya/bare",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "offset": {
        "type": "integer",
        "minimum": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1
      },
      "raw": {
        "type": "boolean"
      }
    },
    "required": [
      "path"
    ]
  },
  "entrypoint": {
    "native": "read"
  }
}
